# ---------------------------------------------------------------------------
# Zamp AP Automation - Environment Configuration
# ---------------------------------------------------------------------------

# AI API Keys (Optional - runs in deterministic rules mode if unset)
# Gemini: google-genai client (supports multimodal/vision + structured JSON)
GEMINI_API_KEY=
# Groq: OpenAI-compatible REST API (fast text LLM)
GROQ_API_KEY=

# Database Persistence (Primary: MongoDB Atlas, Secondary: PostgreSQL)
# MongoDB Atlas URI (Recommended):
# Example: mongodb+srv://user:password@cluster0.xyz.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=zamp_ap

# PostgreSQL Persistence (Secondary):
# Example: postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=




# Central Autonomous Agent Bot Base Gmail Address
# Invoices can be sent to: {AGENT_BOT_EMAIL_USER}+{company_name}@gmail.com
# Example: zamp.ap.agent+zampcorp@gmail.com
AGENT_BOT_EMAIL=zamp.ap.agent@gmail.com

# 16-Character Google App Password for the Bot Gmail Address
# Generate at: https://myaccount.google.com/apppasswords
# When set, enables the autonomous background worker to poll imap.gmail.com:993 every 10s
AGENT_BOT_APP_PASSWORD=
