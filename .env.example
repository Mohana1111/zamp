# ===========================================================================
# ClearPay AP (Zamp AP Automation) - Environment Configuration
# ===========================================================================

# ---------------------------------------------------------------------------
# Server Runtime & Port
# ---------------------------------------------------------------------------
# Render dynamically sets PORT (typically 10000). Defaults to 10000 for local Docker.
PORT=10000

# CORS Allowed Origins (Comma-separated list or * for all)
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# OCR & Memory Safety (Render Free Tier 512MB RAM Budget)
# ---------------------------------------------------------------------------
# 'auto'   : Lazily loads RapidOCR on demand, downscaling large images (max 1600px)
#            and processing at most 5 pages before immediately freeing ONNX models.
# 'false'  : Disables local RapidOCR to save RAM; uses Gemini Vision if key provided,
#            or marks low-confidence for human review without crashing.
ENABLE_LOCAL_OCR=auto

# ---------------------------------------------------------------------------
# Authentication & Security
# ---------------------------------------------------------------------------
# Per-install password salt (optional). If empty, an auto-generated random salt
# is persisted in backend/data/.auth_salt.
AUTH_SALT=

# Session expiration time in seconds (Default: 604800 = 7 days)
SESSION_TTL_SECONDS=604800

# Built-in Default Admin Credentials:
# Username : admin_1
# Password : pass@admin

# ---------------------------------------------------------------------------
# Database Persistence (Primary: MongoDB Atlas, Secondary: PostgreSQL)
# ---------------------------------------------------------------------------
# MongoDB Atlas URI (Recommended for multi-container and ephemeral deployments):
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=zamp_ap

# PostgreSQL (Secondary Fallback):
# Example: postgresql://username:password@ep-sample.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# AI Perception & Review (Optional - System runs full 8-stage deterministic rules if unset)
# ---------------------------------------------------------------------------
# Gemini API Key (Vision OCR fallback, multimodal extraction & cross-check):
GEMINI_API_KEY=

# Groq API Key (High-speed LLM review and flaw summary):
GROQ_API_KEY=
