{
  "manifest_version": 3,
  "name": "ClearPay AP — Gmail Ingestion & Dashboard Bridge",
  "version": "2.4.0",
  "description": "Connects live Gmail threads, invoices, and quotations directly to your ClearPay AP Autonomous Dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClearPay AP Dashboard Bridge"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:8000/*",
    "http://localhost:5173/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "http://localhost:5173/*",
        "http://localhost:8000/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
